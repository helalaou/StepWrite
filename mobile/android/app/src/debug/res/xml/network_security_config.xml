<?xml version="1.0" encoding="utf-8"?>
<!-- The emulator reaches the server on this computer at http://localhost
     through adb reverse. Release builds keep Android's HTTPS-only default. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
